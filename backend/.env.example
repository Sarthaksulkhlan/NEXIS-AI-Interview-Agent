# AI Interview Agent Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Deterministic Simulation Mode (Set to true for free offline development & testing)
MOCK_LLM=false

# LLM Provider Configuration (Used when MOCK_LLM=false)
# Supported providers: "openai", "anthropic", "groq", "ollama", "custom"
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=30.0
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1

# Anthropic Claude Configuration (Alternative)
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Constraints & Policy
MIN_QUESTIONS_REQUIRED=8
MIN_UNIQUE_DAYS_REQUIRED=4
MAX_FOLLOWUPS_PER_DAY=2
